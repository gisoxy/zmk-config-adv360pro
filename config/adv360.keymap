#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ht_layer: ht_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&caps_word>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1          &kp N2     &kp N3     &kp N4      &kp N5  &tog 1                                                                                  &mo 5               &kp N6  &kp N7            &kp N8             &kp N9          &kp N0        &kp MINUS
&kp CLCK   &kp Q           &kp W      &kp E      &kp R       &kp T   &kp LA(LC(LG(N1)))                                                                      &kp LA(LC(LG(N3)))  &kp Y   &kp U             &kp I              &kp O           &kp P         &kp BSLH
&kp TAB    &kp A           &kp S      &kp D      &kp F       &kp G   &kp LA(LC(LG(N2)))  &kp LGUI            &kp ESCAPE        &kp HOME       &kp END        &kp LA(LC(LG(N4)))  &kp H   &kp J             &kp K              &kp L           &kp SEMI      &kp SQT
&kp LSHFT  &kp Z           &kp X      &kp C      &kp V       &kp B                                           &kp LEFT_ALT      &kp PAGE_UP                                       &kp N   &kp M             &kp COMMA          &kp DOT         &kp FSLH      &kp RSHFT
&mo 3      &kp LEFT_ARROW  &kp RIGHT  &kp GRAVE  &kp ESCAPE          &kp SPACE           &ht_layer 2 DELETE  &kp LCTRL         &kp PAGE_DOWN  &kp BACKSPACE  &kp ENTER                   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOWN_ARROW  &kp UP_ARROW  &mo 4
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 5      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        help {
            bindings = <
&trans  &trans             &trans             &trans             &trans             &trans             &trans                                                  &trans              &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans             &trans             &trans             &trans             &trans             &kp LA(LC(LG(N5)))                                      &kp LA(LC(LG(N7)))  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp LA(LC(LG(A)))  &kp LA(LC(LG(S)))  &kp LA(LC(LG(D)))  &kp LA(LC(LG(F)))  &kp LA(LC(LG(G)))  &kp LA(LC(LG(N6)))  &trans  &trans      &trans  &trans  &kp LA(LC(LG(N8)))  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans             &trans             &trans             &trans             &trans                                         &trans      &trans                              &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans             &trans             &trans             &trans                                &trans              &trans  &trans      &trans  &trans  &trans                        &trans    &trans  &trans     &trans  &trans
            >;
        };

        fn-l {
            display-name = "Fn-left";
            bindings = <
&kp F1  &kp F2              &kp F3          &kp F4          &kp F5          &kp F6           &tog 1                                                 &mo 5   &kp F7             &kp F8             &kp F9                 &kp F10              &kp F11               &kp F12
&trans  &none               &none           &none           &none           &none            &none                                                  &none   &kp LA(LC(LG(Y)))  &kp LA(LC(LG(U)))  &kp LA(LC(LG(I)))      &kp LA(LC(LG(O)))    &kp LA(LC(LG(P)))     &kp LA(LC(LG(BSLH)))
&trans  &kp LC(LS(LG(N4)))  &kp LC(LS(N4))  &kp LC(LS(N5))  &kp LC(LS(N3))  &kp PRINTSCREEN  &none              &trans  &trans      &trans  &trans  &none   &kp LA(LC(LG(H)))  &kp LA(LC(LG(J)))  &kp LA(LC(LG(K)))      &kp LA(LC(LG(L)))    &kp LA(LC(LG(SEMI)))  &kp LA(LC(LG(APOS)))
&trans  &none               &none           &none           &none           &none                                       &trans      &trans                  &kp LA(LC(LG(N)))  &kp LA(LC(LG(M)))  &kp LA(LC(LG(COMMA)))  &kp LA(LC(LG(DOT)))  &kp LA(LC(LG(FSLH)))  &trans
&trans  &trans              &trans          &trans          &trans                           &kp LS(LA(SPACE))  &trans  &trans      &trans  &trans  &trans                     &trans             &trans                 &trans               &trans                &trans
            >;
        };

        fn-r {
            display-name = "Fn-right";
            bindings = <
&kp F1  &kp F2             &kp F3             &kp F4             &kp F5             &kp F6             &tog 1                                      &mo 5   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp LA(LC(LG(Q)))  &kp LA(LC(LG(W)))  &kp LA(LC(LG(E)))  &kp LA(LC(LG(R)))  &kp LA(LC(LG(T)))  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LA(LC(LG(A)))  &kp LA(LC(LG(S)))  &kp LA(LC(LG(D)))  &kp LA(LC(LG(F)))  &kp LA(LC(LG(G)))  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LA(LC(LG(Z)))  &kp LA(LC(LG(X)))  &kp LA(LC(LG(C)))  &kp LA(LC(LG(V)))  &kp LA(LC(LG(B)))                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans             &trans             &trans             &trans                                &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &to 6         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        g_l {
            bindings = <
&kp ESC  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5  &none                                      &to 0  &none  &none  &none  &none  &none  &none
&none    &none      &kp Q   &kp W   &kp E   &kp R   &none                                      &none  &none  &none  &none  &none  &none  &none
&none    &none      &kp A   &kp S   &kp D   &kp F   &none      &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none    &kp LSHFT  &kp Z   &kp X   &kp C   &kp V                     &none      &none                &none  &none  &none  &none  &none  &none
&none    &kp LCTRL  &none   &none   &none           &kp SPACE  &none  &none      &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };
    };
};
